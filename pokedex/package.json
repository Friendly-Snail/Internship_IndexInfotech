{
  "name": "pokemon-api-hono-drizzle",
  "version": "2.0.0",
  "private": true,
  "module": "src/server.ts",
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "start": "bun src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "format": "oxfmt src drizzle.config.ts package.json",
    "format:check": "oxfmt --check src drizzle.config.ts package.json",
    "lint": "oxlint ."
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.0.0",
    "ky": "^2.1.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "^5.9.2"
  }
}
