{
  "name": "pokemon-api-hono-drizzle",
  "version": "2.0.0",
  "private": true,
  "module": "src/server.ts",
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "start": "bun src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "format": "oxfmt src test drizzle.config.ts package.json tsconfig.json .oxfmtrc.json",
    "format:check": "oxfmt --check src test drizzle.config.ts package.json tsconfig.json .oxfmtrc.json",
    "lint": "oxlint ."
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-validator": "^0.9.1",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.2",
    "hono": "^4.0.0",
    "ky": "^2.1.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@electric-sql/pglite": "0.3.14",
    "@types/bun": "latest",
    "@types/node": "^26.6.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "drizzle-kit": "^0.31.0",
    "openapi3-ts": "^4.6.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "^5.9.2"
  }
}
