{
  "name": "pokemon-api-hono-drizzle",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "module": "src/hono-server.ts",
  "scripts": {
    "dev": "bun run --bun vite dev",
    "start": "bun run start:hono",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "format": "bun run --bun oxfmt --ignore-path .oxfmtignore src test scripts drizzle.config.ts package.json tsconfig.json .oxfmtrc.json .oxlintrc.json vite.config.ts",
    "format:check": "bun run --bun oxfmt --ignore-path .oxfmtignore --check src test scripts drizzle.config.ts package.json tsconfig.json .oxfmtrc.json .oxlintrc.json vite.config.ts",
    "lint": "oxlint --deny-warnings src test scripts drizzle.config.ts vite.config.ts",
    "auth:generate": "bunx --bun auth@1.7.7 generate --config ./src/auth.ts --output ./src/db/schema/auth-schema.ts --yes",
    "db:up": "docker compose up -d --wait --wait-timeout 90 postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs --tail=100 postgres",
    "db:check": "bun scripts/check-db.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "dev:hono": "bun --hot src/hono-server.ts",
    "start:hono": "bun src/hono-server.ts",
    "build": "bun run --bun vite build",
    "generate-routes": "bun run --bun tsr generate"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-validator": "^0.9.1",
    "@t3-oss/env-core": "^0.13.11",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-start": "1.169.1",
    "better-auth": "1.7.7",
    "date-fns": "^4.4.0",
    "dotenv": "17.2.3",
    "drizzle-orm": "0.45.2",
    "hono": "^4.0.0",
    "ky": "^2.1.0",
    "pg": "8.16.3",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@electric-sql/pglite": "0.3.14",
    "@tanstack/router-cli": "1.167.17",
    "@types/bun": "latest",
    "@types/node": "^26.6.4",
    "@types/pg": "8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.0.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "drizzle-kit": "^0.31.0",
    "openapi3-ts": "^4.6.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "^5.9.2",
    "vite": "8.0.0"
  }
}
