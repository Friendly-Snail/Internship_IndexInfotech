# copy to .env.local; match the user/password/database in .env.postgres and URL-encode special password characters
DATABASE_URL=postgresql://pokedex:POSTGRES_PASSWORD@127.0.0.1:5433/pokedex

# match the origin the browser uses for the app (vite dev runs on port 3000)
BETTER_AUTH_URL=http://localhost:3000
# generate a random secret using: bun -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG
